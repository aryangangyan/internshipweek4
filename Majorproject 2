<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mini Amazon - E-Commerce Website</title>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #eaeded;
}

/* HEADER */

header {
    background: #131921;
    color: white;
    padding: 12px 25px;
    display: flex;
    align-items: center;
    gap: 20px;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: #ff9900;
    font-size: 28px;
    font-weight: bold;
    white-space: nowrap;
}

.search {
    flex: 1;
    display: flex;
}

.search input {
    width: 100%;
    padding: 12px;
    border: none;
    font-size: 16px;
}

.search button {
    background: #febd69;
    border: none;
    padding: 0 20px;
    cursor: pointer;
}

.cart-btn {
    background: #ff9900;
    border: none;
    padding: 11px 18px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    white-space: nowrap;
}

/* NAVIGATION */

nav {
    background: #232f3e;
    padding: 12px 25px;
    display: flex;
    gap: 20px;
}

nav button {
    background: none;
    color: white;
    border: none;
    cursor: pointer;
    font-size: 15px;
}

nav button:hover {
    color: #ff9900;
}

/* HERO */

.hero {
    background: linear-gradient(120deg, #243b55, #141e30);
    color: white;
    text-align: center;
    padding: 50px 20px;
}

.hero h1 {
    font-size: 38px;
    margin-bottom: 10px;
}

.hero p {
    font-size: 18px;
}

/* MAIN */

.container {
    max-width: 1200px;
    margin: auto;
    padding: 30px 20px;
}

.section-title {
    margin-bottom: 20px;
}

/* PRODUCTS */

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.product {
    background: white;
    border-radius: 10px;
    padding: 15px;
    text-align: center;
    box-shadow: 0 3px 10px rgba(0,0,0,0.12);
    transition: 0.2s;
}

.product:hover {
    transform: translateY(-4px);
}

.product img {
    width: 100%;
    height: 190px;
    object-fit: contain;
    margin-bottom: 10px;
}

.product h3 {
    margin: 8px 0;
}

.category {
    color: #777;
    font-size: 14px;
}

.price {
    font-size: 21px;
    font-weight: bold;
    margin: 12px;
}

.product button {
    padding: 9px 12px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin: 3px;
}

.details-btn {
    background: #e7e7e7;
}

.add-btn {
    background: #ff9900;
}

/* CART */

.cart-section {
    background: white;
    margin-top: 35px;
    padding: 25px;
    border-radius: 10px;
    display: none;
}

.cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
    gap: 15px;
}

.cart-info {
    flex: 1;
}

.quantity button {
    padding: 5px 10px;
    border: 1px solid #aaa;
    background: white;
    cursor: pointer;
}

.remove {
    background: #dc3545;
    color: white;
    border: none;
    padding: 7px 12px;
    border-radius: 4px;
    cursor: pointer;
}

.total {
    text-align: right;
    font-size: 24px;
    font-weight: bold;
    margin-top: 20px;
}

.checkout {
    background: #198754;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 15px;
}

/* MODAL */

.modal {
    display: none;
    position: fixed;
    z-index: 200;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.65);
}

.modal-box {
    background: white;
    width: 90%;
    max-width: 500px;
    margin: 80px auto;
    padding: 25px;
    border-radius: 10px;
    text-align: center;
}

.modal-box img {
    width: 250px;
    height: 220px;
    object-fit: contain;
}

.close {
    float: right;
    font-size: 28px;
    cursor: pointer;
}

/* FOOTER */

footer {
    background: #131921;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
}

/* MOBILE */

@media(max-width:700px) {

    header {
        flex-wrap: wrap;
    }

    .logo {
        font-size: 22px;
    }

    .search {
        order: 3;
        width: 100%;
    }

    nav {
        overflow-x: auto;
    }

    .hero h1 {
        font-size: 28px;
    }

    .cart-item {
        flex-wrap: wrap;
    }

}

</style>
</head>


<body>


<!-- HEADER -->

<header>

    <div class="logo">
        Mini Amazon
    </div>

    <div class="search">

        <input
            type="text"
            id="searchBox"
            placeholder="Search products..."
            onkeyup="searchProducts()">

        <button>🔍</button>

    </div>

    <button class="cart-btn" onclick="showCart()">
        🛒 Cart (<span id="cartCount">0</span>)
    </button>

</header>


<!-- NAVIGATION -->

<nav>

    <button onclick="filterProducts('All')">
        All
    </button>

    <button onclick="filterProducts('Electronics')">
        Electronics
    </button>

    <button onclick="filterProducts('Fashion')">
        Fashion
    </button>

    <button onclick="filterProducts('Accessories')">
        Accessories
    </button>

    <button onclick="filterProducts('Study')">
        Study
    </button>

</nav>


<!-- HERO -->

<section class="hero">

    <h1>Welcome to Mini Amazon</h1>

    <p>
        Everything you need, all in one place!
    </p>

</section>


<!-- PRODUCTS -->

<div class="container">

    <h2 class="section-title">
        Featured Products
    </h2>

    <div class="products" id="productList"></div>


    <!-- CART -->

    <div class="cart-section" id="cartSection">

        <h2>🛒 Shopping Cart</h2>

        <br>

        <div id="cartItems"></div>

        <div class="total">

            Total: ₹<span id="totalPrice">0</span>

            <br>

            <button class="checkout" onclick="checkout()">
                Proceed to Checkout
            </button>

        </div>

    </div>

</div>


<!-- PRODUCT DETAILS MODAL -->

<div class="modal" id="modal">

    <div class="modal-box">

        <span class="close" onclick="closeModal()">
            ×
        </span>

        <img id="modalImage">

        <h2 id="modalName"></h2>

        <p id="modalDescription"></p>

        <h2 id="modalPrice"></h2>

        <br>

        <button class="add-btn"
                id="modalAddButton">
            Add to Cart
        </button>

    </div>

</div>


<!-- FOOTER -->

<footer>

    <p>
        © 2026 Mini Amazon | Web Development Major Project
    </p>

    <br>

    <p>
        Designed using HTML, CSS & JavaScript
    </p>

</footer>


<script>


/* PRODUCT DATABASE */

const products = [

    {
        id: 1,
        name: "Smartphone",
        category: "Electronics",
        price: 15999,
        image: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=500",
        description:
        "Modern smartphone with powerful processor, high-quality camera and long-lasting battery."
    },

    {
        id: 2,
        name: "Laptop",
        category: "Electronics",
        price: 49999,
        image: "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=500",
        description:
        "Powerful laptop suitable for students, programming, office work and entertainment."
    },

    {
        id: 3,
        name: "Wireless Headphones",
        category: "Electronics",
        price: 2499,
        image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500",
        description:
        "Comfortable wireless headphones with clear sound and powerful bass."
    },

    {
        id: 4,
        name: "Smart Watch",
        category: "Accessories",
        price: 2999,
        image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500",
        description:
        "Smart watch with fitness tracking, notifications and stylish design."
    },

    {
        id: 5,
        name: "Running Shoes",
        category: "Fashion",
        price: 1999,
        image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500",
        description:
        "Lightweight running shoes designed for comfort and everyday use."
    },

    {
        id: 6,
        name: "Backpack",
        category: "Accessories",
        price: 1299,
        image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500",
        description:
        "Durable backpack with multiple compartments for college and travel."
    },

    {
        id: 7,
        name: "Digital Camera",
        category: "Electronics",
        price: 35999,
        image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500",
        description:
        "Professional digital camera for high-quality photography."
    },

    {
        id: 8,
        name: "Wireless Keyboard",
        category: "Study",
        price: 1499,
        image: "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500",
        description:
        "Slim wireless keyboard suitable for computers, laptops and study."
    }

];


/* CART */

let cart =
JSON.parse(localStorage.getItem("miniAmazonCart")) || [];


/* DISPLAY PRODUCTS */

function displayProducts(list = products) {

    let productList =
    document.getElementById("productList");

    productList.innerHTML = "";


    if(list.length === 0) {

        productList.innerHTML =
        "<h3>No products found.</h3>";

        return;

    }


    list.forEach(product => {

        productList.innerHTML += `

        <div class="product">

            <img
                src="${product.image}"
                alt="${product.name}">

            <h3>
                ${product.name}
            </h3>

            <p class="category">
                ${product.category}
            </p>

            <p class="price">
                ₹${product.price.toLocaleString()}
            </p>

            <button
                class="details-btn"
                onclick="showDetails(${product.id})">

                View Details

            </button>

            <button
                class="add-btn"
                onclick="addToCart(${product.id})">

                Add to Cart

            </button>

        </div>

        `;

    });

}


/* ADD TO CART */

function addToCart(id) {

    let product =
    products.find(p => p.id === id);


    let existing =
    cart.find(item => item.id === id);


    if(existing) {

        existing.quantity++;

    } else {

        cart.push({
            ...product,
            quantity: 1
        });

    }


    saveCart();

    alert(product.name + " added to cart!");

}


/* SAVE CART */

function saveCart() {

    localStorage.setItem(
        "miniAmazonCart",
        JSON.stringify(cart)
    );

    updateCart();

}


/* UPDATE CART COUNT */

function updateCart() {

    let count =
    cart.reduce(
        (total, item) =>
        total + item.quantity,
        0
    );

    document.getElementById("cartCount")
    .innerText = count;

}


/* SHOW CART */

function showCart() {

    let section =
    document.getElementById("cartSection");

    section.style.display = "block";

    displayCart();

    section.scrollIntoView({
        behavior: "smooth"
    });

}


/* DISPLAY CART */

function displayCart() {

    let cartItems =
    document.getElementById("cartItems");

    cartItems.innerHTML = "";

    let total = 0;


    if(cart.length === 0) {

        cartItems.innerHTML =
        "<p>Your cart is empty.</p>";

        document.getElementById("totalPrice")
        .innerText = "0";

        return;

    }


    cart.forEach((item, index) => {

        total +=
        item.price * item.quantity;


        cartItems.innerHTML += `

        <div class="cart-item">

            <div class="cart-info">

                <strong>
                    ${item.name}
                </strong>

                <br>

                ₹${item.price.toLocaleString()}

            </div>


            <div class="quantity">

                <button
                    onclick="changeQuantity(${index}, -1)">
                    −
                </button>

                <strong>
                    ${item.quantity}
                </strong>

                <button
                    onclick="changeQuantity(${index}, 1)">
                    +
                </button>

            </div>


            <button
                class="remove"
                onclick="removeItem(${index})">

                Remove

            </button>

        </div>

        `;

    });


    document.getElementById("totalPrice")
    .innerText = total.toLocaleString();

}


/* CHANGE QUANTITY */

function changeQuantity(index, change) {

    cart[index].quantity += change;


    if(cart[index].quantity <= 0) {

        cart.splice(index, 1);

    }


    saveCart();

    displayCart();

}


/* REMOVE ITEM */

function removeItem(index) {

    cart.splice(index, 1);

    saveCart();

    displayCart();

}


/* SEARCH */

function searchProducts() {

    let search =
    document.getElementById("searchBox")
    .value
    .toLowerCase();


    let result =
    products.filter(product =>

        product.name
        .toLowerCase()
        .includes(search)

        ||

        product.category
        .toLowerCase()
        .includes(search)

    );


    displayProducts(result);

}


/* CATEGORY FILTER */

function filterProducts(category) {

    if(category === "All") {

        displayProducts(products);

        return;

    }


    let result =
    products.filter(product =>
        product.category === category
    );


    displayProducts(result);

}


/* PRODUCT DETAILS */

function showDetails(id) {

    let product =
    products.find(p => p.id === id);


    document.getElementById("modalImage")
    .src = product.image;


    document.getElementById("modalName")
    .innerText = product.name;


    document.getElementById("modalDescription")
    .innerText = product.description;


    document.getElementById("modalPrice")
    .innerText =
    "₹" + product.price.toLocaleString();


    document.getElementById("modalAddButton")
    .onclick = function() {

        addToCart(product.id);

        closeModal();

    };


    document.getElementById("modal")
    .style.display = "block";

}


/* CLOSE MODAL */

function closeModal() {

    document.getElementById("modal")
    .style.display = "none";

}


/* CHECKOUT */

function checkout() {

    if(cart.length === 0) {

        alert("Your cart is empty!");

        return;

    }


    alert(
        "Thank you for shopping with Mini Amazon! 🎉\n\n" +
        "Your order has been placed successfully."
    );


    cart = [];

    saveCart();

    displayCart();

}


/* INITIAL LOAD */

displayProducts();

updateCart();


</script>

</body>
</html>
