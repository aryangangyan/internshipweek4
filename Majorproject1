<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Management Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f2f4f7;
            padding: 20px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        header {
            background: #1f4e79;
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

        header h1 {
            margin-bottom: 8px;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .card h2 {
            margin-bottom: 15px;
            color: #1f4e79;
        }

        input,
        select {
            width: 100%;
            padding: 11px;
            margin-bottom: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            color: white;
            background: #1f4e79;
        }

        button:hover {
            opacity: 0.85;
        }

        .add-btn {
            width: 100%;
            background: #198754;
        }

        .cancel-btn {
            width: 100%;
            margin-top: 8px;
            background: #6c757d;
        }

        .search-area {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .search-area input {
            margin: 0;
        }

        .search-area select {
            width: 180px;
            margin: 0;
        }

        .count {
            background: #e9f2ff;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
            color: #1f4e79;
            font-weight: bold;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #1f4e79;
            color: white;
            padding: 12px;
        }

        td {
            padding: 11px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        tr:hover {
            background: #f5f5f5;
        }

        .edit {
            background: #ffc107;
            color: black;
            margin-right: 5px;
        }

        .delete {
            background: #dc3545;
        }

        .empty {
            text-align: center;
            padding: 25px;
            color: #777;
        }

        @media (max-width: 800px) {
            .dashboard {
                grid-template-columns: 1fr;
            }

            .search-area {
                flex-direction: column;
            }

            .search-area select {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header>
        <h1>Student Management Dashboard</h1>
        <p>Web Development Major Project</p>
    </header>

    <div class="dashboard">

        <!-- ADD STUDENT FORM -->
        <div class="card">

            <h2 id="formTitle">Add Student</h2>

            <input type="text" id="name" placeholder="Student Name">

            <input type="number" id="roll" placeholder="Roll Number">

            <input type="email" id="email" placeholder="Email Address">

            <select id="course">
                <option value="">Select Course</option>
                <option value="BSc Mathematics">BSc Mathematics</option>
                <option value="BSc Computer Science">BSc Computer Science</option>
                <option value="BCA">BCA</option>
                <option value="BBA">BBA</option>
            </select>

            <button class="add-btn" onclick="saveStudent()" id="saveButton">
                Add Student
            </button>

            <button class="cancel-btn" onclick="cancelEdit()" id="cancelButton" style="display:none;">
                Cancel Edit
            </button>

        </div>


        <!-- STUDENT LIST -->
        <div class="card">

            <h2>Student Records</h2>

            <div class="count">
                Total Students: <span id="studentCount">0</span>
            </div>

            <div class="search-area">

                <input
                    type="text"
                    id="search"
                    placeholder="Search by name, roll or email..."
                    onkeyup="displayStudents()"
                >

                <select id="filterCourse" onchange="displayStudents()">
                    <option value="">All Courses</option>
                    <option value="BSc Mathematics">BSc Mathematics</option>
                    <option value="BSc Computer Science">BSc Computer Science</option>
                    <option value="BCA">BCA</option>
                    <option value="BBA">BBA</option>
                </select>

            </div>


            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Roll No.</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="studentTable"></tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<script>

    // Get existing students from localStorage
    let students = JSON.parse(localStorage.getItem("students")) || [];

    let editIndex = -1;


    // Add sample students if there is no data
    if (students.length === 0) {

        students = [
            {
                name: "Aryan Gangyan",
                roll: "003",
                email: "aryangangyan124@gmail.com",
                course: "BSc Mathematics"
            },
            {
                name: "Kanishka",
                roll: "007",
                email: "kanishka@example.com",
                course: "BSc Mathematics"
            }
        ];

        saveToStorage();
    }


    // Save students to localStorage
    function saveToStorage() {

        localStorage.setItem("students", JSON.stringify(students));

    }


    // Add or Update Student
    function saveStudent() {

        let name = document.getElementById("name").value.trim();
        let roll = document.getElementById("roll").value.trim();
        let email = document.getElementById("email").value.trim();
        let course = document.getElementById("course").value;


        // Validation
        if (name === "" || roll === "" || email === "" || course === "") {

            alert("Please fill all fields.");

            return;
        }


        let student = {
            name: name,
            roll: roll,
            email: email,
            course: course
        };


        // Update student
        if (editIndex !== -1) {

            students[editIndex] = student;

            editIndex = -1;

            document.getElementById("formTitle").innerText = "Add Student";

            document.getElementById("saveButton").innerText = "Add Student";

            document.getElementById("cancelButton").style.display = "none";

        }

        // Add new student
        else {

            students.push(student);

        }


        saveToStorage();

        clearForm();

        displayStudents();

    }


    // Display students
    function displayStudents() {

        let table = document.getElementById("studentTable");

        let search = document
            .getElementById("search")
            .value
            .toLowerCase();

        let filterCourse = document
            .getElementById("filterCourse")
            .value;


        table.innerHTML = "";


        let filteredStudents = students.filter(function(student) {

            let matchesSearch =
                student.name.toLowerCase().includes(search) ||
                student.roll.toLowerCase().includes(search) ||
                student.email.toLowerCase().includes(search);

            let matchesCourse =
                filterCourse === "" ||
                student.course === filterCourse;

            return matchesSearch && matchesCourse;

        });


        document.getElementById("studentCount").innerText =
            filteredStudents.length;


        if (filteredStudents.length === 0) {

            table.innerHTML =
                `<tr>
                    <td colspan="5" class="empty">
                        No students found.
                    </td>
                </tr>`;

            return;
        }


        filteredStudents.forEach(function(student) {

            let originalIndex = students.indexOf(student);

            let row = `
                <tr>

                    <td>${student.name}</td>

                    <td>${student.roll}</td>

                    <td>${student.email}</td>

                    <td>${student.course}</td>

                    <td>

                        <button
                            class="edit"
                            onclick="editStudent(${originalIndex})">
                            Edit
                        </button>

                        <button
                            class="delete"
                            onclick="deleteStudent(${originalIndex})">
                            Delete
                        </button>

                    </td>

                </tr>
            `;

            table.innerHTML += row;

        });

    }


    // Edit student
    function editStudent(index) {

        let student = students[index];

        document.getElementById("name").value = student.name;
        document.getElementById("roll").value = student.roll;
        document.getElementById("email").value = student.email;
        document.getElementById("course").value = student.course;


        editIndex = index;


        document.getElementById("formTitle").innerText =
            "Edit Student";

        document.getElementById("saveButton").innerText =
            "Update Student";

        document.getElementById("cancelButton").style.display =
            "block";

    }


    // Delete student
    function deleteStudent(index) {

        let confirmDelete =
            confirm("Are you sure you want to delete this student?");


        if (confirmDelete) {

            students.splice(index, 1);

            saveToStorage();

            displayStudents();

        }

    }


    // Clear form
    function clearForm() {

        document.getElementById("name").value = "";
        document.getElementById("roll").value = "";
        document.getElementById("email").value = "";
        document.getElementById("course").value = "";

    }


    // Cancel editing
    function cancelEdit() {

        editIndex = -1;

        clearForm();

        document.getElementById("formTitle").innerText =
            "Add Student";

        document.getElementById("saveButton").innerText =
            "Add Student";

        document.getElementById("cancelButton").style.display =
            "none";

    }


    // Display students when page opens
    displayStudents();

</script>

</body>
</html>
